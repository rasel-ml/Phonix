<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/default_spacing"
        android:layout_marginTop="@dimen/default_spacing_small"
        android:layout_marginEnd="@dimen/default_spacing"
        android:layout_marginBottom="@dimen/default_spacing_small"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <app.mrm.phonix.lib.ui.widgets.IconButton
            android:id="@+id/crop_close"
            style="@style/Chooloo.Button.Secondary.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/editor_close"
            app:icon="@drawable/close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_spacing_medium"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/editor_crop_title"
            android:textAppearance="@style/Chooloo.Text.Headline"
            android:textSize="@dimen/headline_4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crop_done"
            style="@style/Chooloo.Button.Save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_crop_done" />
    </LinearLayout>

    <app.mrm.phonix.lib.ui.contacteditor.CropImageView
        android:id="@+id/crop_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/default_spacing"
        android:text="@string/editor_crop_hint"
        android:textAppearance="@style/Chooloo.Text.Caption" />
</LinearLayout>
