<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/default_spacing_big"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/default_spacing_small_plus"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/editor_section_icon"
            android:layout_width="@dimen/icon_button_size_small"
            android:layout_height="@dimen/icon_button_size_small"
            android:importantForAccessibility="no"
            android:padding="3dp"
            app:tint="?colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/editor_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/default_spacing_small_plus"
            android:textAppearance="@style/Chooloo.Text.Title" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/editor_section_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/editor_section_add"
        style="@style/Chooloo.Button.Add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/add" />
</LinearLayout>
